{
  "tls": {
    "listen_address": ":8443",
    "certificates": "/etc/est/certs/server-certificates.pem",
    "private_key": "/etc/est/certs/server-key.pem",
    "client_cas": [
      "/etc/est/certs/client-ca.pem"
    ]
  },
  "allowed_hosts": [
    "localhost",
    "127.0.0.1"
  ],
  "tacra": {
    "client_cert": "/etc/est/certs/est-server-client.pem",
    "client_key": "/etc/est/certs/est-server-client-key.pem",
    "verifiers": {
      "veraison": {
        "url": "https://verifier:8080",
        "ca": "/etc/est/certs/verifier-ca.pem",
        "provider": "sev_guest"
      }
    },
    "rrps": {
      "ca": {
        "url": "https://ca-gateway:9101",
        "ca": "/etc/est/certs/ca-gateway-ca.pem",
        "mode": "enroll",
        "rats_model": "passport",
        "verifiers": ["veraison"]
      },
      "vault": {
        "url": "https://vault-gateway:9102",
        "ca": "/etc/est/certs/vault-gateway-ca.pem",
        "mode": "retrieve",
        "rats_model": "background-check"
      }
    },
    "targets": {
      "https://workload-1.tacra.example": "ca",
      "https://workload-2.tacra.example": "vault"
    },
    "acceptable_evidence": [
      "application/vnd.veraison.tsm-report+cbor"
    ],
    "ca_certs": "/etc/est/certs/ca-certificates.pem"
  },
  "healthcheck_password": "replace-with-a-local-secret",
  "rate_limit": 150,
  "timeout": 30
}
